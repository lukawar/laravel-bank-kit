{
    "name": "lukawar/laravel-bank-kit",
    "keywords": ["laravel", "bank", "elixir", "qr", "transfer", "payment"],
    "license": "proprietary",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "illuminate/console": "^11.0",
        "endroid/qr-code": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "lukawar\\BankKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "lukawar\\BankKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "lukawar\\BankKit\\BankKitServiceProvider"
            ],
            "aliases": {
                "BankKit": "lukawar\\BankKit\\Facades\\BankKit"
            }
        }
    },
    "authors": [
        {
            "name": "lukawar",
            "email": "lwargula@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
