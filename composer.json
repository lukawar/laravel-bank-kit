{
    "name": "lukawar/laravel-bank-kit",
    "keywords": ["laravel", "bank", "elixir", "qr", "transfer", "payment"],
    "license": "proprietary",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "endroid/qr-code": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "laravel/pint": "^1.29",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "lukawar\\BankKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "lukawar\\BankKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "lukawar\\BankKit\\BankKitServiceProvider"
            ],
            "aliases": {
                "BankKit": "lukawar\\BankKit\\Facades\\BankKit"
            }
        }
    },
    "authors": [
        {
            "name": "lukawar",
            "email": "lwargula@gmail.com"
        }
    ],
    "suggest": {
        "ext-gd": "Required for PNG QR codes and the default black square logo."
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "pint --test"
    }
}
